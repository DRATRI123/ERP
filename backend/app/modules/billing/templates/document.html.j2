<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'">
<title>{{ title }} {{ doc.number or "Draft" }}</title>
<style>
  @page { size: {{ page_size }}; margin: {{ cfg.margin_mm }}mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: {{ cfg.font_family }}, "Noto Sans", "Noto Sans Devanagari", "Noto Sans Gujarati", "Nirmala UI", Mangal, Shruti, sans-serif; font-size: {{ cfg.font_size_pt }}pt;
         color: {{ cfg.text_color }}; background: {{ cfg.background_color }}; }
  .copy { position: relative; page-break-after: always; }
  .copy:last-child { page-break-after: auto; }
  .watermark { position: absolute; top: 35%; left: 0; right: 0; text-align: center;
               font-size: 60pt; color: rgba(0,0,0,0.07); transform: rotate(-25deg); z-index: 0; }
  .head { display: flex; justify-content: space-between; align-items: flex-start;
          border-bottom: 2px solid {{ cfg.primary_color }}; padding-bottom: 6px; }
  .head img.logo { max-height: 60px; max-width: 160px; margin-right: 10px; }
  .seller { display: flex; }
  .seller h1 { margin: 0; font-size: 1.6em; color: {{ cfg.primary_color }}; }
  .title { text-align: right; }
  .title h2 { margin: 0; font-size: 1.4em; color: {{ cfg.primary_color }}; text-transform: uppercase; }
  .muted { color: #555; }
  .grid { display: flex; gap: 10px; margin: 8px 0; }
  .box { flex: 1; border: 1px solid #ccc; padding: 6px; }
  .box h3 { margin: 0 0 3px; font-size: 0.9em; color: {{ cfg.primary_color }}; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; }
  th { background: {{ cfg.primary_color }}; color: #fff; font-weight: 600; padding: 4px; text-align: left; }
  td { padding: 4px; border-bottom: 1px solid #ddd; vertical-align: top; }
  td.n, th.n { text-align: right; white-space: nowrap; }
  tr { page-break-inside: avoid; }
  .totals { width: 45%; margin-left: auto; margin-top: 6px; }
  .totals td { border: none; padding: 2px 4px; }
  .totals tr.grand td { border-top: 2px solid {{ cfg.primary_color }}; font-weight: 700; font-size: 1.15em; }
  .foot { display: flex; justify-content: space-between; margin-top: 10px; gap: 10px; }
  .qr img { width: 110px; height: 110px; }
  .sign { text-align: right; min-width: 180px; }
  .sign img { max-height: 60px; }
  .status { color: #b00020; font-weight: 700; }
  .small { font-size: 0.85em; }
</style>
</head>
<body>
{% for copy in cfg.copy_labels %}
<div class="copy">
  {% if cfg.watermark_text or draft or cancelled %}
  <div class="watermark">{{ "CANCELLED" if cancelled else ("DRAFT" if draft else cfg.watermark_text) }}</div>
  {% endif %}
  <div class="head">
    <div class="seller">
      {% if cfg.show_logo and cfg.logo_data_url %}<img class="logo" src="{{ cfg.logo_data_url }}" alt="">{% endif %}
      <div>
        <h1>{{ seller.name }}</h1>
        {% if seller.address_line1 %}<div>{{ seller.address_line1 }}{% if seller.address_line2 %}, {{ seller.address_line2 }}{% endif %}</div>{% endif %}
        {% if seller.city or seller.pincode %}<div>{{ seller.city or "" }} {{ seller.pincode or "" }}</div>{% endif %}
        {% if seller.gstin %}<div><b>GSTIN:</b> {{ seller.gstin }}</div>{% endif %}
        {% if seller.licences %}<div class="small">{% for l in seller.licences %}<b>{{ l.label }}</b> {{ l.number }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
        {% if seller.phone %}<div class="muted">Ph: {{ seller.phone }}{% if seller.email %} · {{ seller.email }}{% endif %}</div>{% endif %}
        {% if cfg.header_text %}<div class="small">{{ cfg.header_text }}</div>{% endif %}
      </div>
    </div>
    <div class="title">
      <h2>{{ title }}</h2>
      <div class="muted small">{{ L(copy) }}</div>
      <div><b>{{ L("No") }}:</b> {{ doc.number or "DRAFT" }}</div>
      <div><b>{{ L("Date") }}:</b> {{ doc.doc_date.strftime("%d-%m-%Y") }}</div>
      {% if doc.due_date %}<div><b>{{ L("Due") }}:</b> {{ doc.due_date.strftime("%d-%m-%Y") }}</div>{% endif %}
      {% if doc.place_of_supply %}<div><b>{{ L("Place of supply") }}:</b> {{ doc.place_of_supply }}{% if pos_name %}-{{ pos_name }}{% endif %}</div>{% endif %}
      {% if doc.reverse_charge %}<div><b>{{ L("Tax payable on reverse charge") }}:</b> Yes</div>{% endif %}
      {% if doc.supplier_invoice_no %}<div><b>{{ L("Supplier inv.") }}:</b> {{ doc.supplier_invoice_no }}</div>{% endif %}
      {% if doc.doctor_id and doc.doctor %}<div><b>{{ L("Doctor") }}:</b> {{ doc.doctor.name }}{% if doc.doctor.registration_no %} (Reg. {{ doc.doctor.registration_no }}){% endif %}</div>{% endif %}
      {% if doc.patient_name %}<div><b>{{ L("Patient") }}:</b> {{ doc.patient_name }}</div>{% endif %}
      {% if doc.rx_number %}<div><b>{{ L("Rx No") }}:</b> {{ doc.rx_number }}</div>{% endif %}
      {% if cancelled %}<div class="status">{{ L("CANCELLED") }}</div>{% endif %}
    </div>
  </div>

  <div class="grid">
    <div class="box">
      <h3>{{ L("Bill to") }}</h3>
      <div><b>{{ buyer.name or doc.party_name or L("Cash Sale") }}</b></div>
      {% set ba = buyer.billing_address %}
      {% if ba %}<div>{{ ba.address_line1 }}{% if ba.address_line2 %}, {{ ba.address_line2 }}{% endif %}</div>
      <div>{{ ba.city or "" }} {{ ba.pincode or "" }}</div>{% endif %}
      {% if buyer.gstin %}<div><b>GSTIN:</b> {{ buyer.gstin }}</div>{% endif %}
      {% if buyer.phone %}<div class="muted">Ph: {{ buyer.phone }}</div>{% endif %}
    </div>
    {% set sa = buyer.shipping_address %}
    {% if sa %}
    <div class="box">
      <h3>{{ L("Ship to") }}</h3>
      <div>{{ sa.address_line1 }}{% if sa.address_line2 %}, {{ sa.address_line2 }}{% endif %}</div>
      <div>{{ sa.city or "" }} {{ sa.pincode or "" }}</div>
    </div>
    {% endif %}
    {% if custom %}
    <div class="box">
      {% for k, v in custom.items() %}<div><b>{{ k }}:</b> {{ v }}</div>{% endfor %}
    </div>
    {% endif %}
  </div>

  <table>
    <thead><tr>
      {% for c in cfg.columns %}
        {% if c == "sno" %}<th>#</th>
        {% elif c == "description" %}<th>{{ L("Item") }}</th>
        {% elif c == "hsn" %}<th>HSN/SAC</th>
        {% elif c == "batch" %}<th>{{ L("Batch") }}</th>
        {% elif c == "expiry" %}<th>{{ L("Exp.") }}</th>
        {% elif c == "qty" %}<th class="n">{{ L("Qty") }}</th>
        {% elif c == "unit" %}<th>{{ L("Unit") }}</th>
        {% elif c == "mrp" %}<th class="n">{{ L("MRP") }}</th>
        {% elif c == "rate" %}<th class="n">{{ L("Rate") }}</th>
        {% elif c == "discount" %}<th class="n">{{ L("Disc.") }}</th>
        {% elif c == "taxable" %}<th class="n">{{ L("Taxable") }}</th>
        {% elif c == "gst_rate" %}<th class="n">{{ L("GST %") }}</th>
        {% elif c == "tax" %}<th class="n">{{ L("Tax") }}</th>
        {% elif c == "amount" %}<th class="n">{{ L("Amount") }}</th>{% endif %}
      {% endfor %}
    </tr></thead>
    <tbody>
    {% for ln in doc.lines %}
      <tr>
      {% for c in cfg.columns %}
        {% if c == "sno" %}<td>{{ ln.line_no }}</td>
        {% elif c == "description" %}<td>{{ ln.description }}{% if ln.serials %}<div class="small muted">S/N: {{ ln.serials | join(", ") }}</div>{% endif %}</td>
        {% elif c == "hsn" %}<td>{{ ln.hsn_sac or "" }}</td>
        {% elif c == "batch" %}<td>{{ ln.batch_no or "" }}</td>
        {% elif c == "expiry" %}<td>{{ ln.expiry_date.strftime("%m/%y") if ln.expiry_date else "" }}</td>
        {% elif c == "qty" %}<td class="n">{{ ln.quantity | qty }}</td>
        {% elif c == "unit" %}<td>{{ ln.unit_code or "" }}</td>
        {% elif c == "mrp" %}<td class="n">{{ ln.mrp | money }}</td>
        {% elif c == "rate" %}<td class="n">{{ ln.unit_price | money }}</td>
        {% elif c == "discount" %}<td class="n">{{ ln.discount_total | money if ln.discount_total else "" }}</td>
        {% elif c == "taxable" %}<td class="n">{{ ln.taxable_value | money }}</td>
        {% elif c == "gst_rate" %}<td class="n">{{ ln.gst_rate | qty }}</td>
        {% elif c == "tax" %}<td class="n">{{ (ln.cgst_amount + ln.sgst_amount + ln.igst_amount + ln.cess_amount) | money }}</td>
        {% elif c == "amount" %}<td class="n">{{ ln.line_total | money }}</td>{% endif %}
      {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <table class="totals">
    <tr><td>{{ L("Taxable value") }}</td><td class="n">{{ doc.taxable_total | money }}</td></tr>
    {% if doc.discount_total %}<tr><td>{{ L("Discount included") }}</td><td class="n">{{ doc.discount_total | money }}</td></tr>{% endif %}
    {% if doc.cgst_total %}<tr><td>CGST</td><td class="n">{{ doc.cgst_total | money }}</td></tr>{% endif %}
    {% if doc.sgst_total %}<tr><td>{{ sgst_label }}</td><td class="n">{{ doc.sgst_total | money }}</td></tr>{% endif %}
    {% if doc.igst_total %}<tr><td>IGST</td><td class="n">{{ doc.igst_total | money }}</td></tr>{% endif %}
    {% if doc.cess_total %}<tr><td>Cess</td><td class="n">{{ doc.cess_total | money }}</td></tr>{% endif %}
    {% if doc.round_off %}<tr><td>{{ L("Round off") }}</td><td class="n">{{ doc.round_off | money }}</td></tr>{% endif %}
    <tr class="grand"><td>{{ L("Total") }}</td><td class="n">₹ {{ doc.grand_total | money }}</td></tr>
    {% if doc.amount_paid %}<tr><td>{{ L("Paid") }}</td><td class="n">{{ doc.amount_paid | money }}</td></tr>
    <tr><td><b>{{ L("Balance due") }}</b></td><td class="n"><b>{{ doc.balance_due | money }}</b></td></tr>{% endif %}
  </table>
  {% if cfg.show_amount_in_words %}<div><b>{{ L("Amount in words") }}:</b> {{ words }}</div>{% endif %}

  {% if cfg.show_tax_summary and doc.tax_total %}
  <table style="margin-top:8px" class="small">
    <thead><tr><th>HSN/SAC</th><th class="n">{{ L("Rate") }}</th><th class="n">{{ L("Taxable") }}</th>
      {% if doc.is_interstate %}<th class="n">IGST</th>{% else %}<th class="n">CGST</th><th class="n">{{ sgst_label }}</th>{% endif %}
      <th class="n">Cess</th></tr></thead>
    <tbody>
    {% for r in tax_rows %}
      <tr><td>{{ r.hsn }}</td><td class="n">{{ r.rate | qty }}%</td><td class="n">{{ r.taxable | money }}</td>
      {% if doc.is_interstate %}<td class="n">{{ r.igst | money }}</td>{% else %}<td class="n">{{ r.cgst | money }}</td><td class="n">{{ r.sgst | money }}</td>{% endif %}
      <td class="n">{{ r.cess | money }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <div class="foot">
    <div style="flex:1">
      {% if cfg.bank_details %}<div><b>{{ L("Bank details") }}:</b> {{ cfg.bank_details }}</div>{% endif %}
      {% if cfg.terms_text or doc.terms %}<div class="small"><b>{{ L("Terms") }}:</b> {{ doc.terms or cfg.terms_text }}</div>{% endif %}
      {% if doc.notes %}<div class="small"><b>{{ L("Notes") }}:</b> {{ doc.notes }}</div>{% endif %}
      {% if doc.irn %}<div class="small"><b>IRN:</b> {{ doc.irn }} · Ack {{ doc.irn_ack_no }}</div>{% endif %}
      {% if doc.eway_bill_no %}<div class="small"><b>{{ L("E-way bill") }}:</b> {{ doc.eway_bill_no }}{% if doc.vehicle_no %} · Vehicle {{ doc.vehicle_no }}{% endif %}</div>{% endif %}
    </div>
    {% if irn_qr %}<div class="qr"><img src="{{ irn_qr }}" alt="e-invoice QR"></div>{% endif %}
    {% if upi_qr %}<div class="qr" style="text-align:center"><img src="{{ upi_qr }}" alt="UPI QR"><div class="small">Scan to pay ₹{{ doc.balance_due | money }}</div></div>{% endif %}
    {% if cfg.show_signature %}
    <div class="sign">
      <div>For {{ seller.name }}</div>
      {% if cfg.stamp_data_url %}<img src="{{ cfg.stamp_data_url }}" alt="">{% endif %}
      {% if cfg.signature_data_url %}<img src="{{ cfg.signature_data_url }}" alt="">{% else %}<div style="height:40px"></div>{% endif %}
      <div>{{ L(cfg.signature_label) }}</div>
    </div>
    {% endif %}
  </div>
  {% if cfg.footer_text %}<div class="small muted" style="text-align:center;margin-top:6px">{{ cfg.footer_text }}</div>{% endif %}
</div>
{% endfor %}
</body>
</html>
