# Copy to backend/.env and fill in. Never commit the real .env.
ERP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ERP_SECRET_KEY=
# SQLite (Phase 1). Relative paths resolve against the backend/ directory.
ERP_DATABASE_URL=sqlite:///./data/erp.db
# PostgreSQL (Phase 9):
# ERP_DATABASE_URL=postgresql+psycopg://erp:password@localhost:5432/erp
ERP_ACCESS_TOKEN_TTL_MINUTES=15
ERP_REFRESH_TOKEN_TTL_DAYS=14
ERP_MAX_USERS_PER_BUSINESS=30
ERP_LOGIN_MAX_FAILURES=5
ERP_LOGIN_LOCKOUT_MINUTES=15
ERP_CORS_ORIGINS=["http://localhost:3000"]
# Headless Chromium for invoice PDFs (apt install chromium). Empty = auto-detect.
ERP_PDF_CHROMIUM_PATH=
ERP_PDF_NO_SANDBOX=false
# Encryption keys for integration credentials (JSON list; first encrypts). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_ENCRYPTION_KEYS=[]
# Public HTTPS URL of this ERP, used for webhook and OAuth callback URLs.
ERP_PUBLIC_BASE_URL=https://erp.example.com
# Redis: event stream for the real-time service and shared API rate limits.
ERP_REDIS_URL=redis://localhost:6379/0

# --- Phase 8: security & operations -------------------------------------------------------
# Hosts this API answers to (JSON list). Required in production; empty disables the check.
ERP_ALLOWED_HOSTS=[]
# Behind HTTPS (Caddy): redirect http→https and send HSTS.
ERP_FORCE_HTTPS=false
ERP_TLS_ASK_TOKEN=
ERP_METRICS_TOKEN=
ERP_LOGIN_IP_LIMIT=30
ERP_AUTH_COOKIE=false
# Backups: python -m app.cli backup-keygen   (keep a copy of the key OFF the server)
ERP_BACKUP_KEY=
ERP_BACKUP_DIR=./data/backups
ERP_MIN_FREE_DISK_MB=500
# System e-mail for security alerts (optional)
ERP_SMTP_HOST=
ERP_SMTP_PORT=587
ERP_SMTP_SECURITY=starttls
ERP_SMTP_USERNAME=
ERP_SMTP_PASSWORD=
ERP_SMTP_FROM=
