# Copy to backend/.env and fill in. Never commit the real .env.
ERP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ERP_SECRET_KEY=
# SQLite (Phase 1). Relative paths resolve against the backend/ directory.
ERP_DATABASE_URL=sqlite:///./data/erp.db
# PostgreSQL (Phase 9):
# ERP_DATABASE_URL=postgresql+psycopg://erp:password@localhost:5432/erp
ERP_ACCESS_TOKEN_TTL_MINUTES=15
ERP_REFRESH_TOKEN_TTL_DAYS=14
ERP_MAX_USERS_PER_BUSINESS=30
ERP_LOGIN_MAX_FAILURES=5
ERP_LOGIN_LOCKOUT_MINUTES=15
ERP_CORS_ORIGINS=["http://localhost:3000"]
# Headless Chromium for invoice PDFs (apt install chromium). Empty = auto-detect.
ERP_PDF_CHROMIUM_PATH=
ERP_PDF_NO_SANDBOX=false
