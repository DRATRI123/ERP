# Private ERP — TLS termination and routing.
#
# * The primary host gets its certificate at start-up.
# * Custom domains get theirs on first visit (on-demand TLS), but ONLY after Caddy has asked
#   the API: /api/v1/system/tls-ask returns 200 just for ERP_ALLOWED_HOSTS and domains whose
#   DNS TXT ownership record has been verified. Arbitrary names pointed at this server get
#   no certificate, which also protects the Let's Encrypt rate limits.
{
	email {$ERP_ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/api/v1/system/tls-ask?token={$ERP_TLS_ASK_TOKEN}
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(erp) {
	encode zstd gzip

	# Probes and metrics are for the internal network only.
	@internal path /api/v1/metrics /api/v1/system/tls-ask
	respond @internal 404

	handle /ws* {
		reverse_proxy realtime:8090
	}
	handle /api/* {
		reverse_proxy api:8000
		request_body {
			max_size 30MB
		}
	}
	# The Next.js frontend will be served here (added with the frontend).
	handle {
		respond "Private ERP" 200
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

{$ERP_PRIMARY_HOST} {
	import erp
}

# Every other host name: certificate on demand, gated by the ask endpoint above.
https:// {
	tls {
		on_demand
	}
	import erp
}
