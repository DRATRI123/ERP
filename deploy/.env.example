# Copy to deploy/.env (chmod 600). Never commit it. Every empty value must be filled in.

# --- host names -------------------------------------------------------------------------
ERP_PRIMARY_HOST=erp.example.com
ERP_ACME_EMAIL=admin@example.com
# JSON list: every host the API answers to (custom domains are added in the app instead).
ERP_ALLOWED_HOSTS=["erp.example.com"]
ERP_PUBLIC_BASE_URL=https://erp.example.com
ERP_FORCE_HTTPS=true
ERP_CORS_ORIGINS=["https://erp.example.com"]

# --- secrets (generate each one; see docs/deployment.md) ---------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
ERP_SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_ENCRYPTION_KEYS=[""]
# docker compose run --rm api python -m app.cli backup-keygen   (KEEP A COPY OFF THE SERVER)
ERP_BACKUP_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_TLS_ASK_TOKEN=
ERP_METRICS_TOKEN=

# --- database --------------------------------------------------------------------------
ERP_DATABASE_URL=sqlite:////app/data/erp.db
# With the postgres profile:
# POSTGRES_PASSWORD=
# ERP_DATABASE_URL=postgresql+psycopg://erp:<POSTGRES_PASSWORD>@postgres:5432/erp

# --- browser sessions --------------------------------------------------------------------
# Refresh token in an httpOnly cookie (recommended once the web frontend is deployed).
ERP_AUTH_COOKIE=false

# --- system e-mail for security alerts (optional) ----------------------------------------
ERP_SMTP_HOST=
ERP_SMTP_PORT=587
ERP_SMTP_SECURITY=starttls
ERP_SMTP_USERNAME=
ERP_SMTP_PASSWORD=
ERP_SMTP_FROM=
